+def catalog_with_hidden(home, cwd=None):
+    """The side panel's catalog: every ACP session, hidden ones included, with the `hidden` flag.
+
+    ``catalog_sessions`` is the view ``session/list`` projects and keeps the listing's rule — hidden
+    and archived rows are not in it. A side panel's tabs are the inverse projection (a tab is an
+    *unhidden* session), so it needs both halves and the flag: the same rows out of the same store,
+    read with ``include_hidden`` on the query.
+
+    The ids are the logical ones ``catalog_sessions`` reports, for the same reason: a tab the editor
+    holds must be an id ``session/load`` accepts, and compression advanced the physical rows.
+    """
+    normalized = _normalize_cwd_for_compare(cwd) if cwd else None
+    owners = read_local_owners(home)
+    results = {}
+    for sid, row in read_catalog_rows(home, include_hidden=True).items():
+        sid = row.get("_lineage_root_id") or sid
+        sid = owners.get(sid, sid)
+        count = int(row.get("message_count") or 0)
+        session_cwd = row.get("cwd") or _parse_model_config(row.get("model_config")).get("cwd", ".")
+        if count <= 0 or (normalized and _normalize_cwd_for_compare(session_cwd) != normalized):
+            continue
+        entry = {
+            "session_id": sid,
+            "cwd": session_cwd,
+            "title": row.get("title") or "",
+            "hidden": bool(int(row.get("hidden") or 0)),
+            "message_count": count,
+            "updated_at": float(row.get("last_active") or row.get("started_at") or 0.0),
+        }
+        # One row per logical conversation: its most recently active segment represents it.
+        held = results.get(sid)
+        if held is None or _updated_at_sort_key(entry["updated_at"]) > _updated_at_sort_key(held["updated_at"]):
+            results[sid] = entry
+    return sorted(results.values(), key=lambda item: _updated_at_sort_key(item["updated_at"]), reverse=True)
