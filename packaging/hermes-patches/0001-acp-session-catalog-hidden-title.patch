+    async def ext_method(self, method: str, params: dict[str, Any]) -> dict[str, Any]:
+        """Handle ``_``-prefixed ACP extension requests (the sidebar's session visibility).
+
+        A sidebar whose tabs are a projection of ``sessions.hidden`` needs the full catalog
+        including hidden rows, and a way to flip the flag. Neither belongs on
+        ``session/list``: that is the visible catalog every other ACP client sees, and its
+        meaning ("what may I show") must not change.
+        """
+        handlers = {
+            "session/catalog": self._ext_session_catalog,
+            "session/setHidden": self._ext_session_set_hidden,
+            "session/setTitle": self._ext_session_set_title,
+        }
+        handler = handlers.get(method)
+        if handler is None:
+            raise RequestError.method_not_found(f"_{method}")
+        return await handler(params or {})
+
+    async def _ext_session_catalog(self, params: dict[str, Any]) -> dict[str, Any]:
+        raw_cwd = params.get("cwd")
+        cwd = raw_cwd if isinstance(raw_cwd, str) and raw_cwd.strip() else None
+        sessions = await asyncio.to_thread(self.session_manager.session_catalog, cwd)
+        return {"sessions": sessions}
+
+    async def _ext_session_set_hidden(self, params: dict[str, Any]) -> dict[str, Any]:
+        session_id = str(params.get("sessionId") or "").strip()
+        hidden = params.get("hidden")
+        if not session_id or not isinstance(hidden, bool):
+            raise RequestError.invalid_params("session/setHidden needs {sessionId: string, hidden: boolean}")
+        ok = await asyncio.to_thread(self.session_manager.set_session_hidden, session_id, hidden)
+        if not ok:
+            raise RequestError.invalid_params(f"unknown session {session_id}")
+        logger.info("Session %s hidden=%s", session_id, hidden)
+        return {"ok": True, "sessionId": session_id, "hidden": hidden}
+
+    async def _ext_session_set_title(self, params: dict[str, Any]) -> dict[str, Any]:
+        """Retitle a session on the client's behalf.
+
+        The sidebar owns no titles: the write lands on the ``sessions`` row as a ``user`` title
+        (so the agent's auto-titler can never overwrite it) and the client reads the new name
+        back from the catalog. A refusal — a name another session holds, or one past the
+        length limit — is passed through, because that text is all the user sees.
+        """
+        session_id = str(params.get("sessionId") or "").strip()
+        title = params.get("title")
+        if not session_id or not isinstance(title, str):
+            raise RequestError.invalid_params({"reason": "session/setTitle needs {sessionId: string, title: string}"})
+        try:
+            ok = await asyncio.to_thread(self.session_manager.set_session_title, session_id, title)
+        except ValueError as exc:
+            raise RequestError.invalid_params({"reason": str(exc)}) from exc
+        if not ok:
+            raise RequestError.invalid_params({"reason": f"unknown session {session_id}"})
+        logger.info("Session %s retitled", session_id)
+        return {"ok": True, "sessionId": session_id, "title": title}
+
