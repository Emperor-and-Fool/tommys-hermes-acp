diff --git a/acp_adapter/session.py b/acp_adapter/session.py
index 1f6b2813bd5..f04cb4094ae 100644
--- a/acp_adapter/session.py
+++ b/acp_adapter/session.py
@@ -207,6 +207,81 @@ class SessionManager:
         logger.info("Forked ACP session %s -> %s", session_id, new_id)
         return state
 
+    def session_catalog(self, cwd: str | None = None, *, include_hidden: bool = True) -> list[dict[str, Any]]:
+        """Every persisted ACP session with its ``hidden`` flag, newest activity first.
+
+        ``list_sessions`` answers "what may this client show", so hidden rows never appear
+        there. A sidebar whose tabs are the inverse projection (a tab is an *unhidden*
+        session) needs both halves plus the flag, which is why this reads the store rather
+        than the in-memory set: a hidden session that is currently loaded is still hidden.
+        """
+        db = self._get_db()
+        if db is None:
+            return []
+        normalized_cwd = _normalize_cwd_for_compare(cwd) if cwd else None
+        # 0.22.5 keeps the creating surface in `created_source` and rewrites `source` to
+        # 'local'; 0.22.2 has no such column and `source` still holds the surface. Ask the
+        # method what it accepts instead of keeping a version table: one call, both bases.
+        import inspect
+
+        accepts_local_sources = "local_created_sources" in inspect.signature(
+            db.list_sessions_rich
+        ).parameters
+        try:
+            if accepts_local_sources:
+                rows = db.list_sessions_rich(source="acp", local_created_sources=["acp"],
+                                             limit=500, include_hidden=include_hidden,
+                                             compact_rows=True)
+            else:
+                rows = db.list_sessions_rich(source="acp", limit=500, include_hidden=include_hidden,
+                                             compact_rows=True)
+        except Exception:
+            logger.debug("Failed to load the ACP session catalog", exc_info=True)
+            return []
+        catalog: list[dict[str, Any]] = []
+        for row in rows:
+            message_count = int(row.get("message_count") or 0)
+            if message_count <= 0:
+                continue
+            session_cwd = row.get("cwd") or _parse_model_config(row.get("model_config")).get("cwd", ".")
+            if normalized_cwd and _normalize_cwd_for_compare(session_cwd) != normalized_cwd:
+                continue
+            session_id = str(row.get("id") or "")
+            if not session_id:
+                continue
+            catalog.append({
+                "session_id": session_id,
+                "cwd": session_cwd,
+                "title": row.get("title") or "",
+                "hidden": bool(int(row.get("hidden") or 0)),
+                "message_count": message_count,
+                "updated_at": float(row.get("last_active") or row.get("started_at") or 0.0),
+            })
+        catalog.sort(key=lambda item: item["updated_at"], reverse=True)
+        return catalog
+
+    def set_session_hidden(self, session_id: str, hidden: bool) -> bool:
+        """Hide/unhide one session (and its compression lineage); still resumable."""
+        db = self._get_db()
+        if db is None:
+            return False
+        try:
+            return bool(db.set_session_hidden(session_id, bool(hidden)))
+        except Exception:
+            logger.debug("Failed to set hidden=%s on session %s", hidden, session_id, exc_info=True)
+            return False
+
+    def set_session_title(self, session_id: str, title: str) -> bool:
+        """Rename one session as the user (``title_source='user'``), so auto-titling cannot undo it.
+
+        Raises ValueError when Hermes refuses the name — empty, past the length limit, or already
+        held by another session; that text is what the client shows. False means no such session.
+        """
+        db = self._get_db()
+        if db is None:
+            return False
+        return bool(db.set_session_title(session_id, title))
+
     def list_sessions(self, cwd: str | None = None) -> list[dict[str, Any]]:
         """Return lightweight info dicts for all sessions (memory + database)."""
         normalized_cwd = _normalize_cwd_for_compare(cwd) if cwd else None
