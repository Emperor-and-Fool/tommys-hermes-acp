# The secondant's own ignore list: the primary's, minus the secondant's own leftovers.
#
# Used via `vsce package --ignoreFile`, which replaces `.vscodeignore` rather than adding to it,
# so everything the primary needs to leave out is repeated here.
.vscode/**
node_modules/**
# vsce 4 splits .vscodeignore into an ignore list and a negate list, and a negate wins over
# every ignore line regardless of order. So the dependency folder is re-included with its
# exclusions spelled inside the negate itself.
!node_modules/@agentclientprotocol/**/!(*.test.*|*.map|*.d.ts)
!node_modules/zod/*
!node_modules/zod/v3/**
!node_modules/zod/v4/**
!node_modules/zod/v4-mini/**
!node_modules/zod/mini/**
!node_modules/zod/locales/**
src/**
tsconfig.json
.gitignore
PLAN.md
CODE_REVIEW*.md
.sessions.json
.chat-history.json
out/tests/
out/**/*.d.ts
out/**/*.js.map
docs/**
tests/**
.git-blame-ignore-revs
media/icon.svg
scripts/**
.github/**
packaging/**
.mocharc.yml
.vscode-test/**
package-lock.json
*.vsix
*.old

# The primary's own entry points are not the secondant's: its activation is
# out/host/extensionSecondant.js, and installing secondants is the primary's job.
out/host/extension.js
out/host/extension.js.map
out/host/secondantInstall.js
out/host/secondantInstall.js.map
extras/**/dist/**
extras/**/build/**
extras/**/.build-venv/**
extras/**/__pycache__/**
dist/**
