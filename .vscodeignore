.vscode/**
node_modules/**
# vsce 4 splits .vscodeignore into an ignore list and a negate list, and a negate wins over
# every ignore line regardless of order. So the dependency folder is re-included with its
# exclusions spelled inside the negate itself; a separate `node_modules/**/*.map` line below
# would have no effect.
!node_modules/@agentclientprotocol/**/!(*.test.*|*.map|*.d.ts)
!node_modules/zod/*
!node_modules/zod/v3/**
!node_modules/zod/v4/**
!node_modules/zod/v4-mini/**
!node_modules/zod/mini/**
!node_modules/zod/locales/**
src/**
tsconfig.json
.gitignore
PLAN.md
CODE_REVIEW*.md
.sessions.json
.chat-history.json
out/tests/
out/**/*.d.ts
out/**/*.js.map
docs/**
tests/**
.git-blame-ignore-revs
media/icon.svg
scripts/**
.github/**
packaging/**
.mocharc.yml
.vscode-test/**
package-lock.json
*.vsix
!secondant/tommys-hermes-secondant.vsix
*.old
# `extras/` carries the systray app's sources, which the extension launches.
# Its build output and venv must not ride along: a .deb sitting in dist/ at
# packaging time would otherwise land inside the VSIX.
extras/**/dist/**
extras/**/build/**
extras/**/.build-venv/**
extras/**/__pycache__/**
dist/**
